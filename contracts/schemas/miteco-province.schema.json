{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Archivo provincial del conjunto MITECO publicado",
  "description": "provinces/NN.json que genera el pipeline y lee la web. Contrato 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["province", "schema_version", "stations"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "province": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\d{2}$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "stations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/station" }
    }
  },
  "$defs": {
    "nullableText": {
      "description": "null cuando la cadena oficial está vacía; nunca \"\".",
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address",
        "brand",
        "fuels",
        "id",
        "locality",
        "location",
        "municipality",
        "municipality_id",
        "opening_hours",
        "postal_code"
      ],
      "properties": {
        "id": {
          "description": "IDEESS de MITECO.",
          "type": "string",
          "pattern": "^\\d+$"
        },
        "municipality_id": { "type": "string", "pattern": "^\\d+$" },
        "municipality": { "type": "string", "minLength": 1 },
        "locality": { "$ref": "#/$defs/nullableText" },
        "postal_code": { "type": "string", "pattern": "^\\d{5}$" },
        "address": { "type": "string", "minLength": 1 },
        "brand": { "$ref": "#/$defs/nullableText" },
        "opening_hours": { "$ref": "#/$defs/nullableText" },
        "location": {
          "description": "WGS84 dentro de los límites de España que aplica el pipeline.",
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": 27.5, "maximum": 44 },
            "longitude": { "type": "number", "minimum": -18.5, "maximum": 4.5 }
          }
        },
        "fuels": {
          "description": "Solo productos con precio; una clave ausente es «sin dato», no cero.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/fuelCode" },
          "additionalProperties": {
            "description": "Precio decimal positivo serializado como cadena.",
            "type": "string",
            "pattern": "^(?!0+(\\.0+)?$)\\d+(\\.\\d+)?$"
          }
        }
      }
    },
    "fuelCode": {
      "enum": [
        "adblue",
        "ammonia",
        "biodiesel",
        "bioethanol",
        "compressed_natural_biogas",
        "liquefied_natural_biogas",
        "renewable_diesel",
        "compressed_natural_gas",
        "liquefied_natural_gas",
        "liquefied_petroleum_gas",
        "diesel_a",
        "diesel_b",
        "premium_diesel",
        "gasoline_95_e10",
        "gasoline_95_e25",
        "gasoline_95_e5",
        "premium_gasoline_95_e5",
        "gasoline_95_e85",
        "gasoline_98_e10",
        "gasoline_98_e5",
        "renewable_gasoline",
        "hydrogen",
        "methanol"
      ]
    }
  }
}
