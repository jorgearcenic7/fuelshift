{
  "name": "fuelshift",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Aplicación web pública para consultar y analizar precios oficiales de carburantes en España.",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "data:prepare": "node scripts/prepare-map-data.mjs",
    "data:seed-published": "node scripts/fetch-published-manifest.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.19.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "ajv": "8.20.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.1",
    "wrangler": "4.167.0"
  }
}
